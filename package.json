{
  "name": "formatter-tools",
  "private": true,
  "devDependencies": {
    "prettier": "^3.2.0"
  },
  "scripts": {
    "format": "bash scripts/generate-gitops-manifests.sh --manifests-only && prettier --ignore-path /dev/null --write 'images.yaml' 'generated/lightspeed-stack.yaml' 'llama-stack-configs/**/*.{yaml,yml}'",
    "verify": "bash scripts/generate-gitops-manifests.sh --manifests-only && prettier --ignore-path /dev/null --check 'images.yaml' 'generated/lightspeed-stack.yaml' 'llama-stack-configs/**/*.{yaml,yml}'"
  },
  "version": "0.1.0"
}
